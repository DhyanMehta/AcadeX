      "parameters": {
        "jsCode": "// Get the student email from the webhook payload\nconst studentEmail = $('Webhook').first().json.body.student_email;\n\n// Get all rows from Google Sheets\nconst rows = $input.all();\n\n// Find the matching row\nconst match = rows.find(row => row.json['Student-Email'] === studentEmail);\n\nif (!match) {\n  throw new Error('No parent email found for student: ' + studentEmail);\n}\n\n// Extract parent email\nconst parentEmail = match.json['Parent-Email'];\n\n// Merge webhook data + parent email into one object\nconst webhookData = $('Webhook').first().json.body;\n\nreturn [{\n  json: {\n    student_name:    webhookData.student_name,\n    student_email:   webhookData.student_email,\n    enrollment_no:   webhookData.enrollment_no,\n    class_name:      webhookData.class_name,\n    risk_label:      webhookData.risk_label,\n    risk_score:      webhookData.risk_score,\n    meeting_time:    webhookData.meeting_time,\n    teacher_remarks: webhookData.teacher_remarks,\n    parent_email:    parentEmail\n  }\n}];"
      },
